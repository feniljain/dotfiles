# QoL
mouse-hide-while-typing = true

# Phew finally my clipboard isnt spammed with selected text
copy-on-select = false

# Get tmux working
macos-option-as-alt = left

# https://github.com/ghostty-org/ghostty/discussions/3836
cursor-style = block
# now below config is set by default when config above is manually
# set: https://github.com/ghostty-org/ghostty/issues/8681
# But we will it around for strictness :)
shell-integration-features = no-cursor
cursor-style-blink = false

# Font
font-family = FiraCode Nerd Font Mono
font-size = 12
# font-style-bold = true

# Blur the background like iterm
background-blur = true
background-opacity = 0.9

theme = desert

macos-titlebar-style = hidden

# When away from terminal, notify on command which took more than 30s to finish
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s
