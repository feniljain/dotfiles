# This is Git's per-user configuration file.
[user]
	email = fkjainco@gmail.com
	name = feniljain

[color]
	ui = true

[diff]
        tool = difftastic

[difftool]
        prompt = false

[difftool "difftastic"]
        cmd = difft "$LOCAL" "$REMOTE"

# Use a pager for large output, just like other git commands.
[pager]
        difftool = true

# `git dft` is less to type than `git difftool`.
[alias]
        dft = difftool

[init]
	defaultBranch = main

[merge]
	conflictstyle = zdiff3

[rerere]
	enabled = true

[diff]
	algorithm = histogram

[blame]
	ignoreRevsFile =

[core]
	excludesfile = ~/.gitignore
	pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
	syntax-theme = ansi

[transfer]
	fsckobjects = true

[fetch]
	fsckobjects = true

[receive]
	fsckobjects = true

[status]
	submoduleSummary = true

[diff]
	submodule = log

[branch]
	sort = -committerdate

[diff]
	colorMoved = default
	context = 10

[rebase]
	missingCommitsCheck = error

[rebase]
	updateRefs = true

# Mostly took inspiration from: https://jvns.ca/blog/2024/02/16/popular-git-config-options/

[url "git@github.com:"]
  insteadOf = https://github.com/

# https://stackoverflow.com/questions/11623862/fetch-in-git-doesnt-get-all-branches
# https://stackoverflow.com/questions/54922704/git-cloning-error-fatal-multiple-updates-for-ref-not-allowed
[remote "origin"]
	fetch = +refs/archive/*:refs/archive/*
 	# fetch = +refs/heads/*:refs/remotes/origin/*
	# fetch = +refs/heads/*:refs/remotes/origin/*
